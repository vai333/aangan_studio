{
  "name": "aangan-enquiry-desk",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "typecheck": "tsc --noEmit",
    "eval": "node scripts/embed-context.mjs && tsx --conditions=react-server evals/run.ts",
    "eval:live": "node scripts/embed-context.mjs && tsx --conditions=react-server --env-file-if-exists=.env.local evals/run.ts --live",
    "context": "node scripts/embed-context.mjs",
    "predev": "node scripts/embed-context.mjs",
    "prebuild": "node scripts/embed-context.mjs",
    "db:migrate": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/migrate.ts",
    "vaani:setup": "python3 scripts/vaani-setup.py",
    "test:e2e": "tsx --conditions=react-server scripts/e2e-db.ts",
    "hubspot:check": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/hubspot-check.ts",
    "test:hubspot": "tsx --conditions=react-server scripts/e2e-hubspot.ts",
    "dev:demo": "node scripts/embed-context.mjs && AANGAN_DEMO=1 next dev -p 3100",
    "webhook:url": "node scripts/webhook-url.mjs",
    "vaani:import": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/vaani-import.ts",
    "vaani:simulate": "tsx --env-file-if-exists=.env.local scripts/prompt-sim.mts",
    "test:payloads": "tsx --conditions=react-server scripts/test-vaani-payloads.ts"
  },
  "dependencies": {
    "@google/genai": "^2.28.0",
    "@neondatabase/serverless": "^1.2.0",
    "next": "^16.4.0",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
