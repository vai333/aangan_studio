# Leave DATABASE_URL empty to run in DEMO mode (September replay, no database).

# Neon Postgres: console.neon.tech → your project → Connection details. Use the POOLED string, e.g.
#   postgresql://user:pass@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# A localhost URL (postgres://…@localhost/…) also works for local development.
# Server-only: never prefix with NEXT_PUBLIC_.
DATABASE_URL=

# Admin sign-in (no third-party auth service)
ADMIN_EMAILS=nikhil@aangan.studio
ADMIN_PASSWORD=
SESSION_SECRET=change-me-to-a-long-random-string

# Vaani (Vaani Research: docs.vaanivoice.ai). Key + agent are created by `npm run vaani:setup`.
VAANI_API_KEY=
VAANI_AGENT_ID=
# Secret token appended to the webhook URL: https://<app>/api/vaani/webhook?token=<this>  (`npm run webhook:url` prints it)
VAANI_WEBHOOK_TOKEN=
# Only if Vaani shows a signing secret for the webhook:
VAANI_WEBHOOK_SECRET=

# Gemini grader
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.5-flash

# Resend (designer handoff, escalations, and the per-call report)
RESEND_API_KEY=
EMAIL_FROM="Aangan Enquiry Desk <desk@your-verified-domain.in>"
# Address that receives a summary email after EVERY call (Settings overrides this once saved)
CALL_REPORT_EMAIL=
RESEND_WEBHOOK_SECRET=

# HubSpot (the founder's whole-business view). Private App token: HubSpot → Settings → Integrations →
# Private Apps → scopes: crm.objects.contacts.read/write, crm.objects.deals.read/write, crm.schemas.deals.read
# Then `npm run hubspot:check` verifies it and lists your pipeline and stage IDs.
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_PORTAL_ID=

# App
APP_URL=http://localhost:3100
ACK_SECRET=change-me-to-a-long-random-string
CRON_SECRET=change-me-too
